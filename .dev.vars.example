# Copy to .dev.vars. Do not commit .dev.vars. These are not production secrets.
# PAY_TO is a public var in wrangler.jsonc. Uncomment to override it locally.
# PAY_TO=0x4C1265A4c0e7128aa71513080988dD609f3fDC32
# Only required when FACILITATOR_URL is the Coinbase CDP mainnet facilitator.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# Stripe Machine Payments stays off unless STRIPE_MACHINE_PAYMENTS=true.
# Set the values with `wrangler secret put`. Do not put a real key here.
# STRIPE_MACHINE_PAYMENTS=true
# STRIPE_SECRET_KEY=
# STRIPE_DEPOSIT_ADDRESS=
# STRIPE_PROFILE_ID=
