{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "a11y-probe-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-18",
  "compatibility_flags": ["nodejs_compat"],
  // axe-core builds its injectable source with Function#toString(). Wrangler's
  // default keep_names injects an esbuild `__name` helper into that string.
  "keep_names": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  // Landing page and /legal. `wrangler deploy` uploads ./public with the Worker.
  // Paths outside run_worker_first are served from the ASSETS binding.
  // a11y.aiagentpay.cloud is already attached to this Worker. It is not
  // listed under routes, so a deploy does not rebind the custom domain.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/mcp", "/api/*"]
  },
  "browser": {
    "binding": "BROWSER"
  },
  // 10 paid calls per minute per key, in each Cloudflare location.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  // Daily page counters only. This id is the namespace on the deployed testnet Worker.
  "kv_namespaces": [
    {
      "binding": "CAPS",
      "id": "10c7bfb486484f00b9fe8719a1f38f63"
    }
  ],
  // Testnet by default (Base Sepolia). `env.production` is Base mainnet.
  // PAY_TO is a public receiving address, not a secret. Override it with a
  // PAY_TO secret or .dev.vars entry to swap wallets, including a future
  // Stripe crypto deposit address, without a code change.
  // CDP keys are unused on the testnet facilitator.
  "vars": {
    "INFO_URL": "https://a11y.aiagentpay.cloud/",
    "X402_NETWORK": "eip155:84532",
    "FACILITATOR_URL": "https://x402.org/facilitator",
    "GLOBAL_DAILY_PAGE_CAP": "20",
    "PAY_TO": "0x4C1265A4c0e7128aa71513080988dD609f3fDC32"
  },
  "secrets": {
    "required": ["CDP_API_KEY_ID", "CDP_API_KEY_SECRET"]
  },
  "env": {
    "production": {
      "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "html_handling": "auto-trailing-slash",
        "not_found_handling": "404-page",
        "run_worker_first": ["/mcp", "/api/*"]
      },
      "browser": {
        "binding": "BROWSER"
      },
      "ratelimits": [
        {
          "name": "RATE_LIMITER",
          "namespace_id": "1001",
          "simple": {
            "limit": 10,
            "period": 60
          }
        }
      ],
      // Still a placeholder. Create a production namespace before the first mainnet deploy.
      "kv_namespaces": [
        {
          "binding": "CAPS",
          "id": "00000000000000000000000000000000"
        }
      ],
      "vars": {
        "INFO_URL": "https://a11y.aiagentpay.cloud/",
        "X402_NETWORK": "eip155:8453",
        "FACILITATOR_URL": "https://api.cdp.coinbase.com/platform/v2/x402",
        "GLOBAL_DAILY_PAGE_CAP": "20",
        "PAY_TO": "0x4C1265A4c0e7128aa71513080988dD609f3fDC32"
      },
      "secrets": {
        "required": ["CDP_API_KEY_ID", "CDP_API_KEY_SECRET"]
      }
    }
  }
}
